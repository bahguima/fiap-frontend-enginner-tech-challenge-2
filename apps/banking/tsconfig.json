{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "types": [
      "@testing-library/jest-dom",
      "jest",
      "node",
      "react",
      "react-dom"
    ],
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
