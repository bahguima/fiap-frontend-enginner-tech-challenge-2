{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "banking",
  "sourceRoot": "apps/banking/src",
  "projectType": "application",
  "tags": ["type:app", "scope:banking"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/banking --max-warnings=0"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/banking/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --config jest.config.mjs apps/banking --runInBand"
      }
    }
  }
}
