# Portas publicadas no host.
SHELL_PORT=4200
INSTITUTIONAL_PORT=8101
DASHBOARD_PORT=8102

# URL pública da API REST. Vazio usa a mesma origem da aplicação.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_MOCKING=enabled
NEXT_PUBLIC_API_MOCK_DELAY_MS=150

# URLs vistas pelo navegador, não nomes internos dos serviços do Compose.
INSTITUTIONAL_REMOTE_URL=http://127.0.0.1:8101/remoteEntry.js
DASHBOARD_REMOTE_URL=http://127.0.0.1:8102/remoteEntry.js
SHELL_PUBLIC_URL=http://127.0.0.1:4200

# Identificador local opcional para as imagens de produção.
IMAGE_TAG=local
